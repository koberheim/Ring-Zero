  "reference": {
    "normal": {
      "label": "Standard machine",
      "description": "Surface attacker: walls funnel it; close complete seals take reduced wall damage."
    },
    "foundry": {
      "label": "Foundry",
      "description": "Slow, durable surface attacker. Counter with Mass Drivers and focused fire."
    },
    "transfer": {
      "label": "Transfer",
      "description": "Hops past one ring, then follows ordinary defenses. Counter with defense in depth."
    },
    "sapper": {
      "label": "Sapper",
      "description": "Attacks exposed ring relays; loss browns out the outward chain. Camps at a dead relay, threatening Rebuild Relay, until topology changes or it is killed. Counter with Point Defense."
    },
    "breacher": {
      "label": "Breacher",
      "description": "Seeks walls and damages them at full rate. Use wall redundancy and area denial."
    },
    "tunneler": {
      "label": "Tunneler",
      "description": "Immune underground; attacks an inner wedge after surfacing. Counter with inner Point Defense and solar abilities."
    },
    "assembler": {
      "label": "Assembler",
      "description": "Boss ignores walls and permanently gains HP/damage from its own destruction. Use focused fire before growth."
    }
  },
